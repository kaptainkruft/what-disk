<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhatDisk.ViewModels"
             xmlns:controls="using:WhatDisk.Views.Controls"
             x:Class="WhatDisk.Views.VolumePicker"
             x:DataType="vm:MainWindowViewModel"
             Width="420">
  <UserControl.Resources>
    <DataTemplate x:Key="VolumeSummary" x:DataType="vm:VolumeItemViewModel">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <controls:PlatformIcon Subject="{Binding Volume}" IconSize="32" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock TextTrimming="CharacterEllipsis">
            <Run Text="{Binding Name}" FontWeight="SemiBold" />
            <Run Text="  " />
            <Run Text="{Binding MountPoint}" Foreground="{DynamicResource TextMutedBrush}" />
          </TextBlock>
          <controls:PercentBar Classes="disk" Height="14" Value="{Binding UsedFraction}" Text="{Binding UsedPercentText}" />
          <TextBlock Classes="muted small" Text="{Binding CapacityText}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="8">
    <TextBlock Classes="card-title" Text="Volumes" />
    <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding AllowsMultipleVolumes}"
               Text="Tick one or more drives, then scan them together." />
    <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding !AllowsMultipleVolumes}"
               Text="Choose a volume to scan it. Mount network shares first to see them here." />
    <TextBlock Classes="muted" Text="Loading volumes…" IsVisible="{Binding IsLoadingVolumes}" />

    <ScrollViewer MaxHeight="420">
      <Panel>
        <!-- Several volumes at once (Windows drive letters) -->
        <ItemsControl ItemsSource="{Binding Volumes}" IsVisible="{Binding AllowsMultipleVolumes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VolumeItemViewModel">
              <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VolumeSummary}" HorizontalContentAlignment="Stretch" />
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- One volume at a time -->
        <ItemsControl ItemsSource="{Binding Volumes}" IsVisible="{Binding !AllowsMultipleVolumes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VolumeItemViewModel">
              <Button Classes="volume"
                      Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ScanVolumeCommand}"
                      CommandParameter="{Binding}"
                      Click="OnVolumeButtonClick">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VolumeSummary}" HorizontalContentAlignment="Stretch" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </ScrollViewer>

    <Button Classes="accent" HorizontalAlignment="Right" Content="Scan selected volumes"
            Command="{Binding StartScanCommand}" IsVisible="{Binding AllowsMultipleVolumes}"
            Click="OnVolumeButtonClick" />
  </StackPanel>
</UserControl>
