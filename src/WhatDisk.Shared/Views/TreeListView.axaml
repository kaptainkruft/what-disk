<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhatDisk.ViewModels"
             xmlns:controls="using:WhatDisk.Views.Controls"
             x:Class="WhatDisk.Views.TreeListView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Classes="tree-header">
      <controls:TreeRowPanel x:Name="HeaderPanel" Height="30" />
    </Border>

    <ListBox x:Name="RowsList"
             Grid.Row="1"
             Classes="tree"
             ItemsSource="{Binding Tree.Rows}"
             SelectedItem="{Binding SelectedRow}"
             SelectionMode="Single"
             AutoScrollToSelectedItem="False">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TreeRowViewModel">
          <controls:TreeRowPanel Classes.pending="{Binding IsPending}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" VerticalAlignment="Center">
              <Border Width="{Binding IndentWidth}" />
              <Panel Grid.Column="1" Width="18">
                <ToggleButton Theme="{StaticResource TreeExpanderToggle}"
                              IsChecked="{Binding IsExpanded}"
                              IsVisible="{Binding IsExpandable}" />
              </Panel>
              <controls:PlatformIcon Grid.Column="2" Subject="{Binding Node}" Margin="0,0,6,0" />
              <TextBlock Grid.Column="3" Classes="name" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding FullPath}">
                <Run Text="{Binding Name}" />
                <Run Text="  " />
                <Run Text="{Binding SecondaryText}" Foreground="{DynamicResource TextMutedBrush}" />
              </TextBlock>
              <Image Grid.Column="4" Source="{StaticResource WhatDisk.Icon.warning}" Width="14" Height="14" Margin="4,0,0,0"
                     IsVisible="{Binding HasError}" ToolTip.Tip="{Binding ErrorText}" />
            </Grid>
            <controls:PercentBar Classes="disk" Value="{Binding PercentOfDisk}" Text="{Binding PercentOfDiskText}" IsVisible="{Binding HasMeasures}" />
            <controls:PercentBar Classes="parent" Value="{Binding PercentOfParent}" Text="{Binding PercentOfParentText}" IsVisible="{Binding HasMeasures}" />
            <TextBlock Classes="number" Text="{Binding SizeText}" />
            <TextBlock Classes="number" Text="{Binding FilesText}" />
            <TextBlock Classes="number" Text="{Binding FoldersText}" />
          </controls:TreeRowPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="1" Classes="empty-hint" Margin="24"
               Text="Choose a volume or a folder above, then press Scan."
               IsVisible="{Binding !HasResults}" />
  </Grid>
</UserControl>
