<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhatDisk.ViewModels"
        xmlns:views="using:WhatDisk.Views"
        x:Class="WhatDisk.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WhatDisk"
        Width="1280" Height="800"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <!--
    The window's menus, declared as Avalonia's documentation describes: on macOS they follow the application menu
    (App.axaml) in the menu bar, elsewhere NativeMenuBar draws them at the top of the window. They are set up once and
    never changed: headers and visibility depend only on the platform, and enabled states follow the commands. macOS
    ignores the access key markers (the underscores) and has Quit, Settings and About in the application menu, unless
    the menu bar is turned off in the settings (then the window's menus include them, as on Windows).
  -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="_File">
        <NativeMenu>
          <NativeMenuItem Header="Open" Command="{Binding OpenCommand}" Gesture="{Binding Platform.Shortcuts.Open}" IsVisible="{Binding CanShellOpen}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="{Binding RevealHeader}" Command="{Binding RevealCommand}" Gesture="{Binding Platform.Shortcuts.Reveal}" IsVisible="{Binding CanShellReveal}" />
          <NativeMenuItem Header="Quick Look" Command="{Binding QuickLookCommand}" Gesture="{Binding Platform.Shortcuts.QuickLookMenu}" IsVisible="{Binding CanShellQuickLook}" />
          <NativeMenuItem Header="{Binding Platform.InfoCommandName}" Command="{Binding GetInfoCommand}" Gesture="{Binding Platform.Shortcuts.GetInfo}" IsVisible="{Binding CanShellShowInfo}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Rescan" Command="{Binding RescanCommand}" Gesture="{Binding Platform.Shortcuts.Rescan}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="{Binding MoveToTrashHeader}" Command="{Binding MoveToTrashCommand}" Gesture="{Binding Platform.Shortcuts.MoveToTrash}" IsVisible="{Binding CanShellTrash}" />
          <NativeMenuItem Header="{Binding DeletePermanentlyHeader}" Command="{Binding DeletePermanentlyCommand}" Gesture="{Binding Platform.Shortcuts.DeletePermanently}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Close Tab" Command="{Binding CloseTabCommand}" Gesture="{Binding Platform.Shortcuts.CloseTab}" />
          <NativeMenuItem Header="{Binding ExitHeader}" Gesture="{Binding Platform.Shortcuts.Quit}" Click="OnExitClicked" IsVisible="{Binding HasWindowMenus}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="_Edit">
        <NativeMenu>
          <NativeMenuItem Header="Copy" Command="{Binding CopyItemsCommand}" Gesture="{Binding Platform.Shortcuts.Copy}" IsVisible="{Binding CanShellCopyItems}" />
          <NativeMenuItem Header="Copy Path" Command="{Binding CopyPathCommand}" Gesture="{Binding Platform.Shortcuts.CopyPath}" IsVisible="{Binding CanShellCopyText}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Select All" Command="{Binding SelectAllCommand}" Gesture="{Binding Platform.Shortcuts.SelectAll}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="_View">
        <NativeMenu>
          <NativeMenuItem Header="Expand All Beneath" Command="{Binding ExpandAllCommand}" Gesture="{Binding Platform.Shortcuts.ExpandAll}" />
          <NativeMenuItem Header="Collapse All Beneath" Command="{Binding CollapseAllCommand}" Gesture="{Binding Platform.Shortcuts.CollapseAll}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="_Tools">
        <NativeMenu>
          <NativeMenuItem Header="Find Duplicates in Scanned Files" Command="{Binding FindDuplicatesInScanCommand}" Gesture="{Binding Platform.Shortcuts.FindDuplicatesInScan}" />
          <NativeMenuItem Header="Find Duplicates in Selection" Command="{Binding FindDuplicatesInSelectionCommand}" Gesture="{Binding Platform.Shortcuts.FindDuplicatesInSelection}" />
          <NativeMenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" Gesture="{Binding Platform.Shortcuts.Settings}" IsVisible="{Binding HasWindowMenus}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="_Help" IsVisible="{Binding HasWindowMenus}">
        <NativeMenu>
          <NativeMenuItem Header="_About WhatDisk" Click="OnAboutClicked" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Panel>
    <DockPanel x:Name="Frame">
      <!-- The menus above, drawn here where the platform has no native menu bar (it hides itself on macOS). -->
      <NativeMenuBar DockPanel.Dock="Top" />

      <!--
        The tabs: Scan, which cannot be closed, then a tab for each duplicate search's results and, when open, the
        settings. Everything stays in this one window, so the macOS menu bar never switches between windows' menus.
      -->
      <Border DockPanel.Dock="Top" Classes="tab-strip">
        <TabStrip x:Name="TabStrip" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
          <TabStrip.ItemTemplate>
            <DataTemplate x:DataType="vm:TabViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                <Button Classes="tab-close" IsVisible="{Binding CanClose}" ToolTip.Tip="Close Tab"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="×" />
                </Button>
              </StackPanel>
            </DataTemplate>
          </TabStrip.ItemTemplate>
        </TabStrip>
      </Border>

      <!-- Progress -->
      <Border DockPanel.Dock="Bottom" Classes="statusbar">
        <DockPanel>
          <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" IsVisible="{Binding IsScanning}"
                       Width="72" MinWidth="72" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" VerticalAlignment="Center" />
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0"
                      IsVisible="{Binding ErrorSummary, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Image Source="{StaticResource WhatDisk.Icon.warning}" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Classes="warning" Text="{Binding ErrorSummary}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding ProgressPath}" Margin="16,0,0,0" VerticalAlignment="Center"
                     HorizontalAlignment="Right" TextTrimming="PrefixCharacterEllipsis" />
        </DockPanel>
      </Border>

      <!-- The tabs' pages: each stays in place while hidden, so it keeps its scroll position, columns and selection. -->
      <Panel>
        <ItemsControl x:Name="TabPages" ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Panel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <!-- The Scan tab's page is the main view below. -->
            <DataTemplate DataType="vm:ScanTabViewModel">
              <Panel IsVisible="False" />
            </DataTemplate>
            <DataTemplate DataType="vm:DuplicateResultsViewModel">
              <views:DuplicatesView IsVisible="{Binding IsSelected}" />
            </DataTemplate>
            <DataTemplate DataType="vm:SettingsViewModel">
              <views:SettingsView IsVisible="{Binding IsSelected}" />
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>

        <DockPanel x:Name="ScanPage" IsVisible="{Binding IsScanTabSelected}">
        <!-- What to scan (disabled while a duplicate search runs, since a new scan would replace the tree it searches) -->
        <Border DockPanel.Dock="Top" Classes="toolbar">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <DropDownButton x:Name="VolumesButton" ToolTip.Tip="Choose a volume to scan" IsEnabled="{Binding !IsFindingDuplicates}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Image Source="{StaticResource WhatDisk.Icon.volume}" Width="16" Height="16" />
                <TextBlock Text="Volumes" VerticalAlignment="Center" />
              </StackPanel>
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnVolumesFlyoutOpening">
                  <views:VolumePicker x:Name="Picker" />
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <TextBox Grid.Column="1"
                     x:Name="PathBox"
                     IsEnabled="{Binding !IsFindingDuplicates}"
                     Text="{Binding PathText}"
                     PlaceholderText="{Binding PathWatermark}"
                     VerticalContentAlignment="Center">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding StartScanCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseCommand}" IsVisible="{Binding CanBrowse}"
                    ToolTip.Tip="Choose a folder with the system dialog and scan it" />
            <Button Grid.Column="3" Classes="accent" Content="Scan" Command="{Binding StartScanCommand}" MinWidth="72" />
            <Button Grid.Column="4" Content="Stop" Command="{Binding StopScanCommand}" MinWidth="64" />
          </Grid>
        </Border>

        <!-- Results: the tree on the left, chart and details on the right -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" MinWidth="420" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="260" />
          </Grid.ColumnDefinitions>
          <views:TreeListView x:Name="TreeList" Grid.Column="0" />
          <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />
          <Grid Grid.Column="2" Margin="0,8,8,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" MinHeight="220" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="240" />
            </Grid.RowDefinitions>
            <views:ChartPane Grid.Row="0" />
            <GridSplitter Grid.Row="1" Height="8" Background="Transparent" ResizeDirection="Rows" />
            <!-- The narrow potential duplicates pane sits above the details, so the splitter still resizes the chart. -->
            <DockPanel Grid.Row="2">
              <views:PotentialDuplicatesPane DockPanel.Dock="Top" Margin="0,0,0,8" />
              <views:DetailsPane />
            </DockPanel>
          </Grid>
        </Grid>
        </DockPanel>
      </Panel>
    </DockPanel>

    <!-- Questions and the About box, shown over the dimmed, disabled window instead of in windows of their own. -->
    <Panel x:Name="DialogLayer" Classes="dialog-layer" IsVisible="False">
      <Border x:Name="DialogCard" Classes="dialog-card" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>
  </Panel>
</Window>
