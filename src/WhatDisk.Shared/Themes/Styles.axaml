<!-- Styles for WhatDisk's views and controls, layered on top of the Fluent theme. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WhatDisk.Views.Controls">
  <Styles.Resources>
    <ControlTheme x:Key="TreeExpanderToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="3">
            <Path x:Name="Chevron"
                  Width="16" Height="16"
                  Data="M 6.5 4.5 L 10 8 L 6.5 11.5"
                  Stroke="{DynamicResource TextSecondaryBrush}"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  RenderTransformOrigin="50%,50%" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:checked /template/ Path#Chevron">
        <Setter Property="RenderTransform" Value="rotate(90deg)" />
      </Style>
      <Style Selector="^:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="ColumnGrip" TargetType="Thumb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="{TemplateBinding Background}">
            <Border Width="1" Margin="0,6" HorizontalAlignment="Center" Background="{DynamicResource HairlineBrush}" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="Thumb.column-grip">
    <Setter Property="Theme" Value="{StaticResource ColumnGrip}" />
  </Style>

  <!-- Window chrome -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource PagePlaneBrush}" />
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.statusbar">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.statusbar TextBlock">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource ChartSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.card-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>
  <Style Selector="TextBlock.number">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBlock.detail-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.chart-total">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.empty-hint">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <!-- Tree list -->
  <Style Selector="Border.tree-header">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Button.column-header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.column-header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
  </Style>
  <Style Selector="ListBox.tree">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ScrollViewer.AllowAutoHide" Value="True" />
  </Style>
  <Style Selector="ListBox.tree ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="controls|TreeRowPanel.drop-target">
    <Setter Property="Background" Value="{DynamicResource DropTargetBrush}" />
  </Style>
  <Style Selector="controls|TreeRowPanel.pending TextBlock.name">
    <Setter Property="FontStyle" Value="Italic" />
  </Style>
  <Style Selector="controls|PercentBar">
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="controls|PercentBar.disk">
    <Setter Property="BarBrush" Value="{DynamicResource DiskBarBrush}" />
    <Setter Property="TrackBrush" Value="{DynamicResource DiskBarTrackBrush}" />
  </Style>
  <Style Selector="controls|PercentBar.parent">
    <Setter Property="BarBrush" Value="{DynamicResource ParentBarBrush}" />
    <Setter Property="TrackBrush" Value="{DynamicResource ParentBarTrackBrush}" />
  </Style>

  <!-- Chart legend and volume picker -->
  <Style Selector="Border.legend">
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.volume">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.volume:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
  </Style>
  <Style Selector="TextBlock.highlighted">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Duplicates window: rows of each set share a shade, alternating from set to set -->
  <Style Selector="TextBlock.column-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.duplicates">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.duplicates ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Grid.duplicate-row.alternate">
    <Setter Property="Background" Value="{DynamicResource AlternateRowBrush}" />
  </Style>
  <Style Selector="Grid.duplicate-row > TextBlock, Grid.duplicate-columns > TextBlock">
    <Setter Property="Margin" Value="10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Settings window: modified settings get an accent bar at their left -->
  <Style Selector="Border.settings-sidebar">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="ListBox.settings-pages">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,10" />
  </Style>
  <Style Selector="TextBlock.settings-title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Grid.setting">
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style Selector="Grid.setting > Border.modified-bar">
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Grid.setting.modified > Border.modified-bar">
    <Setter Property="Background" Value="{DynamicResource DiskBarBrush}" />
  </Style>
  <Style Selector="TextBlock.setting-label">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.setting-label Run.platform-mark">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>
  <Style Selector="TextBlock.setting-path">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, Monaco, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="Button.reset">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- The main window's tab strip -->
  <Style Selector="Border.tab-strip">
    <Setter Property="Padding" Value="8,4,8,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.tab-strip TabStripItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,4" />
  </Style>
  <Style Selector="Button.tab-close">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tab-close TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Margin" Value="0,-2,0,0" />
  </Style>
  <Style Selector="Button.tab-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
  </Style>

  <!-- In-window dialogs: a scrim over the window and a card in the middle -->
  <Style Selector="Panel.dialog-layer">
    <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
  </Style>
  <Style Selector="Border.dialog-card">
    <Setter Property="Background" Value="{DynamicResource PagePlaneBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BoxShadow" Value="0 8 32 0 #40000000" />
    <Setter Property="MaxWidth" Value="520" />
  </Style>

  <!-- A small round "i" button that explains a pane -->
  <Style Selector="Button.info">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ToolTip.ShowDelay" Value="200" />
  </Style>
  <Style Selector="Button.info TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>

  <Style Selector="TextBlock.hash">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, Monaco, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>
</Styles>
