<views:InWindowDialog xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:hosting="using:WhatDisk.Hosting"
                      xmlns:views="using:WhatDisk.Views"
                      x:Class="WhatDisk.Views.AboutView"
                      x:DataType="hosting:AppVersionInfo"
                      Width="400">
  <!-- The About box, shown inside the main window. -->
  <StackPanel Margin="28,24" Spacing="4">
    <Image Source="{StaticResource WhatDisk.Icon.volume}" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,8" />
    <TextBlock Text="{Binding ProductName}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
    <SelectableTextBlock x:Name="VersionLine" Text="{Binding VersionText}" HorizontalAlignment="Center" />
    <TextBlock x:Name="ReleasedLine" Text="{Binding ReleasedText}" HorizontalAlignment="Center" />
    <TextBlock Classes="muted" Text="{Binding CommitText}" HorizontalAlignment="Center"
               IsVisible="{Binding Commit, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock Classes="muted small" x:Name="RuntimeLine" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
    <TextBlock Classes="muted small" Text="{Binding Copyright}" HorizontalAlignment="Center" />
    <Button x:Name="OkButton" Content="OK" IsDefault="True" HorizontalAlignment="Center" MinWidth="80" Margin="0,16,0,0" Click="OnOkClick" />
  </StackPanel>
</views:InWindowDialog>
