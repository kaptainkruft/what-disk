<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhatDisk.ViewModels"
        xmlns:views="using:WhatDisk.Views"
        x:Class="WhatDisk.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WhatDisk"
        Width="1280" Height="800"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- What to scan -->
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <DropDownButton x:Name="VolumesButton" ToolTip.Tip="Choose a volume to scan">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Source="{StaticResource WhatDisk.Icon.volume}" Width="16" Height="16" />
            <TextBlock Text="Volumes" VerticalAlignment="Center" />
          </StackPanel>
          <DropDownButton.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnVolumesFlyoutOpening">
              <views:VolumePicker x:Name="Picker" />
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <TextBox Grid.Column="1"
                 x:Name="PathBox"
                 Text="{Binding PathText}"
                 PlaceholderText="{Binding PathWatermark}"
                 VerticalContentAlignment="Center">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding StartScanCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseCommand}" IsVisible="{Binding CanBrowse}"
                ToolTip.Tip="Choose a folder with the system dialog and scan it" />
        <Button Grid.Column="3" Classes="accent" Content="Scan" Command="{Binding StartScanCommand}" MinWidth="72" />
        <Button Grid.Column="4" Content="Stop" Command="{Binding StopScanCommand}" MinWidth="64" />
      </Grid>
    </Border>

    <!-- Progress -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" IsVisible="{Binding IsScanning}"
                     Width="72" MinWidth="72" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" VerticalAlignment="Center" />
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0"
                    IsVisible="{Binding ErrorSummary, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Image Source="{StaticResource WhatDisk.Icon.warning}" Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock Classes="warning" Text="{Binding ErrorSummary}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="muted" Text="{Binding ProgressPath}" Margin="16,0,0,0" VerticalAlignment="Center"
                   HorizontalAlignment="Right" TextTrimming="PrefixCharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Results: the tree on the left, chart and details on the right -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4*" MinWidth="420" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="260" />
      </Grid.ColumnDefinitions>
      <views:TreeListView x:Name="TreeList" Grid.Column="0" />
      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />
      <Grid Grid.Column="2" Margin="0,8,8,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="220" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>
        <views:ChartPane Grid.Row="0" />
        <GridSplitter Grid.Row="1" Height="8" Background="Transparent" ResizeDirection="Rows" />
        <views:DetailsPane Grid.Row="2" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>
