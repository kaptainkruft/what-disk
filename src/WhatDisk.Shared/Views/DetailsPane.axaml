<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhatDisk.ViewModels"
             xmlns:controls="using:WhatDisk.Views.Controls"
             x:Class="WhatDisk.Views.DetailsPane"
             x:DataType="vm:MainWindowViewModel">
  <Border Classes="card">
    <Panel>
      <DockPanel IsVisible="{Binding Details.HasSelection}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
          <controls:PlatformIcon Subject="{Binding Details.Node}" IconSize="32" Margin="0,0,10,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Classes="card-title" Text="{Binding Details.Title}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="muted" Text="{Binding Details.Subtitle}" />
          </StackPanel>
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Details.Properties}" Margin="0,0,14,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DetailPropertyViewModel">
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Classes="detail-label" Text="{Binding Label}" />
                  <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      <TextBlock Classes="empty-hint" Text="Select an item to see its details." IsVisible="{Binding !Details.HasSelection}" />
    </Panel>
  </Border>
</UserControl>
