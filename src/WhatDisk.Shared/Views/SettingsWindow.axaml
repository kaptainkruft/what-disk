<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhatDisk.ViewModels"
        xmlns:settings="using:WhatDisk.Settings"
        x:Class="WhatDisk.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="860" Height="600"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <!--
    One page per section of the settings file, in the file's order. Each setting shows its label, description and path
    in the file, an editor, and Reset when it differs from the default. A platform's own settings are marked "*".
  -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button x:Name="OpenFileButton" Content="Open Settings File" Command="{Binding OpenFileCommand}"
                  ToolTip.Tip="Edit the settings file in your JSON editor; changes appear when you return here" />
          <Button x:Name="ResetAllButton" Content="Restore Defaults…" Click="OnResetAllClick"
                  ToolTip.Tip="Return every setting on every page to its default" />
          <Button x:Name="CloseButton" Content="Close" MinWidth="72" HorizontalContentAlignment="Center" Click="OnCloseClick" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="warning" Text="{Binding Message}" TextWrapping="Wrap"
                     IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <SelectableTextBlock Classes="muted" FontSize="11" Text="{Binding FileText}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The sections -->
    <Border DockPanel.Dock="Left" Width="180" Classes="settings-sidebar">
      <ListBox x:Name="PagesList" Classes="settings-pages" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SettingsPageViewModel">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- The chosen section's settings -->
    <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,18,24,24" Spacing="4" DataContext="{Binding SelectedPage}" x:DataType="vm:SettingsPageViewModel">
        <TextBlock Classes="settings-title" Text="{Binding Title}" />
        <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <ItemsControl x:Name="ItemsList" ItemsSource="{Binding Items}" Grid.IsSharedSizeScope="True">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingItemViewModel">
              <!-- The editors and Reset buttons share their columns' widths, so they line up from row to row. -->
              <Grid Classes="setting" Classes.modified="{Binding IsModified}" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Editor" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Reset" />
                </Grid.ColumnDefinitions>
                <Border Classes="modified-bar" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="setting-label" TextWrapping="Wrap" ToolTip.Tip="{Binding PlatformTip}">
                    <Run Text="{Binding Label}" />
                    <Run Classes="platform-mark" Text="{Binding PlatformMark}" />
                  </TextBlock>
                  <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" />
                  <TextBlock Classes="setting-path" Text="{Binding Path}" ToolTip.Tip="{Binding PlatformTip}" />
                </StackPanel>
                <ContentControl Grid.Column="2" Content="{Binding}" VerticalAlignment="Center">
                  <ContentControl.DataTemplates>
                    <DataTemplate x:DataType="vm:BoolSettingViewModel">
                      <ToggleSwitch IsChecked="{Binding Value}" OnContent="On" OffContent="Off" MinWidth="0" />
                    </DataTemplate>
                    <DataTemplate x:DataType="vm:IntSettingViewModel">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <NumericUpDown Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                         Increment="1" FormatString="0" Width="130" />
                          <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" MinWidth="52" />
                        </StackPanel>
                        <TextBlock Classes="muted small" Text="{Binding RangeText}" />
                      </StackPanel>
                    </DataTemplate>
                    <DataTemplate x:DataType="vm:ChoiceSettingViewModel">
                      <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" MinWidth="240">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="settings:SettingChoice">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>
                <Button Grid.Column="3" Classes="reset" Content="Reset" Command="{Binding ResetCommand}" VerticalAlignment="Center"
                        IsVisible="{Binding IsModified}" ToolTip.Tip="Return this setting to its default" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted small" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).PlatformNote}"
                   IsVisible="{Binding HasPlatformSettings}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
