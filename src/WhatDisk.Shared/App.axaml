<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WhatDisk.App"
             Name="WhatDisk"
             RequestedThemeVariant="Default">
  <!-- The macOS application menu; Avalonia adds the standard Hide, Show All and Quit items. Elsewhere Settings is in
       the Tools menu. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="About WhatDisk" Click="OnAboutClicked" />
      <NativeMenuItemSeparator />
      <NativeMenuItem Header="Settings…" Gesture="Meta+OemComma" Click="OnSettingsClicked" />
    </NativeMenu>
  </NativeMenu.Menu>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://WhatDisk.Shared/Themes/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://WhatDisk.Shared/Themes/Palette.axaml" />
        <ResourceInclude Source="avares://WhatDisk.Shared/Icons/BuiltInIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
