<Project>
  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <Product>WhatDisk</Product>
    <Company>WhatDisk</Company>
    <Copyright>Copyright (c) 2026 Spiky Ball Software</Copyright>
  </PropertyGroup>

  <!--
    Versioning. Git tags (vMAJOR.MINOR.PATCH[-PRERELEASE]) are the source of truth; the release pipeline computes the
    next version and passes it in:
      -p:VersionPrefix=0.1.3 -p:VersionSuffix=alpha -p:BuildTimestamp=2026-10-17T04:12:00Z
    Local builds are 0.0.0-dev. The SDK appends the commit hash to the informational version (0.1.3-alpha+<sha>).
  -->
  <PropertyGroup>
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(CI)' != 'true'">dev</VersionSuffix>
    <!-- Release builds record when they were built; debug builds omit it so incremental builds stay incremental. -->
    <BuildTimestamp Condition="'$(BuildTimestamp)' == '' and '$(Configuration)' == 'Release'">$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</BuildTimestamp>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildTimestamp)' != ''">
    <AssemblyMetadata Include="BuildTimestamp" Value="$(BuildTimestamp)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
